{
  "name": "myshelltool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:core": "cargo test --manifest-path crates/myshelltool-core/Cargo.toml",
    "test:ui": "node tests/ui-smoke.mjs && node tests/ui-host-key.mjs",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "mcp:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin myshelltool-mcp",
    "mcp:build:release": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin myshelltool-mcp",
    "dev:all": "node scripts/mcp-dev-watch.mjs --with-gui",
    "mcp:watch": "node scripts/mcp-dev-watch.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5",
    "playwright": "^1.60.0",
    "sass": "^1.101.0",
    "vite": "^7.2.7"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38"
  }
}

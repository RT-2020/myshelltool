{
  "name": "myshelltool",
  "version": "0.19.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "type-check": "vue-tsc --build",
    "lint:facts": "node scripts/fact-guards.mjs",
    "lint:size": "node scripts/size-guard.mjs",
    "check:ipc": "node scripts/ipc-contract-check.mjs",
    "build": "node scripts/gen-changelog-history.mjs && npm run lint:facts && npm run lint:size && npm run check:ipc && npm run type-check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:core": "cargo test --manifest-path crates/myshelltool-core/Cargo.toml",
    "test:ui": "node tests/ui-smoke.mjs && node tests/ui-host-key.mjs && node tests/ui-file-loading.mjs && node tests/ui-ipc-flows.mjs && node tests/ui-editor.mjs",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5",
    "playwright": "^1.60.0",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "js-yaml": "^5.4.2",
    "lucide-vue-next": "^0.460.0",
    "marked": "^18.0.13",
    "pinia": "^3.0.4",
    "smol-toml": "^1.8.0",
    "vue": "^3.5.38"
  }
}

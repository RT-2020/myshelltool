{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myshelltool",
  "version": "0.2.0",
  "identifier": "com.redtei.myshelltool",
  "build": {
    "beforeDevCommand": "pnpm run dev -- --port 41234 --strictPort",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:41234",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "myshelltool — SSH 运维客户端",
        "width": 1366,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["WebView2Loader.dll", "libgcc_s_seh-1.dll", "libstdc++-6.dll", "libwinpthread-1.dll"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}

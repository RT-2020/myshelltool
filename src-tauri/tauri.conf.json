{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myshelltool",
  "version": "0.1.0",
  "identifier": "com.redtei.myshelltool",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myshelltool",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
